{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jpease/gpy/schemas/message.json",
  "title": "GPY Agent IPC Message",
  "description": "Messages a shell client sends to the GPY Agent, one JSON object per line, in the op form: {\"op\":...} with flat fields.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "git"
        },
        "cwd": {
          "type": "string",
          "maxLength": 4096,
          "description": "Directory path (shell form key: cwd)"
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "is_first": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the first segment in the prompt (opening-cap suppression)"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "RepositoryStatus (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "lang"
        },
        "cwd": {
          "type": "string",
          "maxLength": 4096,
          "description": "Directory path (shell form key: cwd)"
        },
        "virtual_env": {
          "type": "string",
          "description": "Client-forwarded $VIRTUAL_ENV for venv-aware Python detection"
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "is_first": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the first segment in the prompt (opening-cap suppression)"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "LanguageDetect (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "directory"
        },
        "cwd": {
          "type": "string",
          "maxLength": 4096,
          "description": "Directory path (shell form key: cwd)"
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "is_first": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the first segment in the prompt (opening-cap suppression)"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "DirectoryRequest (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "clock"
        },
        "shell": {
          "type": "string",
          "enum": [
            "fish",
            "zsh",
            "bash"
          ],
          "description": "Shell whose live-clock token to embed; absent/unrecognized falls back to fish"
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "is_first": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the first segment in the prompt (opening-cap suppression)"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "ClockRequest (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "duration"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "is_first": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the first segment in the prompt (opening-cap suppression)"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "DurationRequest (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "character"
        },
        "success": {
          "type": "boolean",
          "default": false,
          "description": "Whether the last command succeeded"
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "CharacterRequest (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "exit_status",
          "description": "The status pill; the bare \"status\" op is the agent health check"
        },
        "success": {
          "type": "boolean",
          "default": false,
          "description": "Whether the last command succeeded"
        },
        "format": {
          "$ref": "#/definitions/Format"
        },
        "is_last": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the last segment in the prompt"
        },
        "is_first": {
          "type": "boolean",
          "default": false,
          "description": "Whether this is the first segment in the prompt (opening-cap suppression)"
        },
        "prev_bg": {
          "type": "string",
          "maxLength": 64,
          "description": "Previous segment's background colour for powerline transitions"
        }
      },
      "title": "ExitStatusRequest (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op",
        "pid"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "register"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304,
          "description": "Client process ID"
        },
        "cwd": {
          "type": "string",
          "maxLength": 4096,
          "description": "Directory path (shell form key: cwd)"
        },
        "shell": {
          "type": "string",
          "maxLength": 64,
          "description": "Shell name (fish, zsh, bash; anything else = unknown)"
        },
        "shell_version": {
          "type": "string",
          "maxLength": 64
        }
      },
      "title": "RegisterClient (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op",
        "pid"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "unregister"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304,
          "description": "Client process ID"
        }
      },
      "title": "UnregisterClient (shell form)"
    },
    {
      "type": "object",
      "required": [
        "op",
        "pid",
        "cwd"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "workspace"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304,
          "description": "Client process ID"
        },
        "cwd": {
          "type": "string",
          "maxLength": 4096,
          "description": "Directory path (shell form key: cwd)"
        }
      },
      "title": "WorkspaceUpdate (shell form)"
    },
    {
      "title": "Ping (shell form)",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "ping"
        }
      }
    },
    {
      "title": "Status (shell form)",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "status"
        }
      }
    },
    {
      "title": "Shutdown (shell form)",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "shutdown"
        }
      }
    },
    {
      "title": "ConfigReload (shell form)",
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "const": "config_reload"
        }
      }
    }
  ],
  "definitions": {
    "Format": {
      "type": "string",
      "description": "Output format. `json` replies with one JSON object (see response.json); `ansi` (Fish), `bash-prompt` and `zsh-prompt` reply with one line of rendered prompt text. An unrecognized or missing value silently falls back to `json`.",
      "default": "json",
      "enum": [
        "json",
        "ansi",
        "bash-prompt",
        "zsh-prompt"
      ]
    }
  }
}
