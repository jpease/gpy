---
source: src/theme/export.rs
expression: "golden_export(Shell::Fish)"
---
# GPY Theme: night$owl"
# Generated by gpy-agent for Fish

set -g __gpy_theme_name "night\$owl\""
set -gx GPY_AGENT_ENABLED "0"
set -gx GPY_AGENT_LIVE_UPDATES "0"
set -gx GPY_AGENT_SUPERVISOR_ENABLED "0"
set -gx GPY_AGENT_SUPERVISOR_CHECK_INTERVAL_SECONDS "45"
set -gx GPY_AGENT_SUPERVISOR_MAX_RESTART_ATTEMPTS "9"
set -gx GPY_AGENT_TIMEOUT_SECONDS "7"
set -gx GPY_LANGUAGE_ENABLED "0"
set -gx GPY_LANGUAGE_SHOW_VERSIONS "0"
set -gx GPY_GIT_ENABLED "1"
set -gx GPY_GIT_SHOW_UPSTREAM "0"
set -gx GPY_GIT_MAX_BRANCH_LENGTH "17"
set -gx GPY_UI_DIRECTORY_MAX_LENGTH "42"
set -gx GPY_UI_DIRECTORY_DISPLAY "truncated"
set -gx GPY_UI_SHOW_ICONS "0"
set -g __prompt_icons "ascii"
set -g __icon_powerline_segment_start ""
set -g __icon_powerline_segment_end ""
set -g __gpy_ui_prompt_icon "➜\$p"
set -g __icon_prompt "➜\$p"
set -g __gpy_ui_prompt_icon_color "magenta"
set -g __prompt_color "magenta"
set -g __gpy_ui_root_prompt_icon "#`r`"
set -g __icon_root_prompt "#`r`"
set -g __gpy_ui_root_prompt_icon_color "yellow"
set -g __root_prompt_color "yellow"
set -g __gpy_two_line "1"
set -g __gpy_add_newline "1"
set -g __color_clock_bg "blue"
set -g __color_clock_fg "white"
set -g __time_format "%H:%M\$(date)"
set -g __clock_show_leading_zero "1"
set -g __clock_show_seconds "1"
set -g __duration_threshold_ms "2500"
set -g __color_directory_bg "cyan"
set -g __color_duration_bg "yellow"
set -g __color_hostname_bg "green"
set -g __color_hostname_fg "black"
set -g __hostname_trim_at ".local\""
set -g __hostname_show_always "1"
set -g __hostname_format "1"
set -g __icon_hostname "host\\"
set -g __color_username_bg "red"
set -g __color_username_fg "white"
set -g __username_show_always "1"
set -g __username_format "1"
set -g __icon_username "user`x`"
set -g __icon_status_ok "ok\$1"
set -g __icon_status_fail "fail`2`"
set -g __color_status_ok_bg "green"
set -g __color_status_ok_fg "black"
set -g __color_status_fail_bg "red"
set -g __color_status_fail_fg "white"
set -g __color_git_clean_bg "green"
set -g __color_git_dirty_bg "red"
set -g __color_language_bg "blue"
set -g __segment_delim_first "["
set -g __segment_delim_start ""
set -g __segment_delim_end ""
set -g __segment_delim_last "]"
set -g __prompt_open_color "cyan"
set -g __prompt_open_bg "blue"
set -g __prompt_close_color "green"
set -g __prompt_close_bg "red"
set -g __segment_delimiter_color "white"
set -g __segment_delimiter_bg "black"
set -g __prompt_base_bg "normal"
set -g __prompt_base_fg "normal"
set -g __gpy_segment_aws_profile_id "aws profile"
set -g __gpy_segment_aws_profile_bg_color "yellow"
set -g __color_aws_profile_bg "yellow"
set -g __gpy_segment_aws_profile_text_color "black"
set -g __color_aws_profile_fg "black"
set -g __gpy_segment_aws_profile_icon "aws"
set -g __icon_aws_profile "aws"
set -g __gpy_segment_aws_profile_open_icon "<"
set -g __gpy_segment_aws_profile_open_icon_color "white"
set -g __gpy_segment_aws_profile_open_bg_color "black"
set -g __gpy_segment_aws_profile_close_icon ">"
set -g __gpy_segment_aws_profile_close_icon_color "black"
set -g __gpy_segment_aws_profile_close_bg_color "white"
set -g __gpy_segment_kubernetes_id "kubernetes"
set -g __gpy_segment_kubernetes_bg_color "blue"
set -g __color_kubernetes_bg "blue"
set -g __gpy_segment_kubernetes_text_color "white"
set -g __color_kubernetes_fg "white"
set -g __gpy_segment_kubernetes_icon "k8s\$ctx"
set -g __icon_kubernetes "k8s\$ctx"
set -g __gpy_segment_kubernetes_context_color "bright-blue"
set -g __color_kubernetes_context "bright-blue"
set -g __gpy_segment_kubernetes_namespace_icon "ns`n`"
set -g __icon_kubernetes_namespace "ns`n`"
set -g __gpy_segment_kubernetes_plain_property "value\\"
set -g __gpy_plugin_segment_file_aws_profile "/usr/share/gpy/segments/aws\$profile.fish"
set -g __gpy_plugin_segment_file_kubernetes "/usr/share/gpy/segments/kubernetes.fish"
