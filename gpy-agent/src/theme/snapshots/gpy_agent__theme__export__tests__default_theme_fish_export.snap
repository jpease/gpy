---
source: src/theme/export.rs
expression: export
---
# GPY Theme: default
# Generated by gpy-agent for Fish

set -g __gpy_theme_name "default"
set -gx GPY_AGENT_ENABLED "1"
set -gx GPY_AGENT_LIVE_UPDATES "1"
set -gx GPY_AGENT_SUPERVISOR_ENABLED "1"
set -gx GPY_AGENT_SUPERVISOR_CHECK_INTERVAL_SECONDS "30"
set -gx GPY_AGENT_SUPERVISOR_MAX_RESTART_ATTEMPTS "5"
set -gx GPY_AGENT_TIMEOUT_SECONDS "5"
set -gx GPY_LANGUAGE_ENABLED "1"
set -gx GPY_LANGUAGE_SHOW_VERSIONS "1"
set -gx GPY_GIT_ENABLED "1"
set -gx GPY_GIT_SHOW_UPSTREAM "1"
set -gx GPY_GIT_MAX_BRANCH_LENGTH "0"
set -gx GPY_UI_DIRECTORY_MAX_LENGTH "80"
set -gx GPY_UI_DIRECTORY_DISPLAY "basename"
set -gx GPY_UI_SHOW_ICONS "1"
set -g __prompt_icons "nerd"
set -g __icon_powerline_segment_start " "
set -g __icon_powerline_segment_end " "
set -g __gpy_ui_prompt_icon "❯"
set -g __icon_prompt "❯"
set -g __prompt_color "green"
set -g __gpy_ui_root_prompt_icon "!❯!"
set -g __icon_root_prompt "!❯!"
set -g __gpy_ui_root_prompt_icon_color "red"
set -g __root_prompt_color "red"
set -g __gpy_two_line "0"
set -g __gpy_add_newline "1"
set -g __color_clock_bg "black"
set -g __color_clock_fg "white"
set -g __time_format "12"
set -g __clock_show_leading_zero "0"
set -g __clock_show_seconds "0"
set -g __duration_threshold_ms "100"
set -g __color_directory_bg "blue"
set -g __color_duration_bg "black"
set -g __color_hostname_bg "black"
set -g __color_hostname_fg "white"
set -g __hostname_trim_at "."
set -g __hostname_show_always "0"
set -g __hostname_format ""
set -g __icon_hostname ""
set -g __color_username_bg "red"
set -g __color_username_fg "white"
set -g __username_show_always "0"
set -g __username_format ""
set -g __icon_username ""
set -e __icon_status_ok
set -e __icon_status_fail
set -g __color_status_ok_bg "green"
set -g __color_status_ok_fg "black"
set -g __color_status_fail_bg "red"
set -g __color_status_fail_fg "black"
set -g __color_git_clean_bg "green"
set -g __color_git_dirty_bg "red"
set -g __color_language_bg "black"
set -g __segment_delim_first " "
set -g __segment_delim_start " "
set -g __segment_delim_end " "
set -g __segment_delim_last ""
set -g __prompt_open_color "white"
set -g __prompt_open_bg "transparent"
set -g __prompt_close_color "white"
set -g __prompt_close_bg "transparent"
set -g __segment_delimiter_color "white"
set -g __segment_delimiter_bg "transparent"
set -g __prompt_base_bg "normal"
set -g __prompt_base_fg "normal"
set -g __enabled_segments clock duration language directory git
set -g __gpy_lang_marker_files .ruby-version CMakeLists.txt Cargo.toml Gemfile Makefile Package.swift Pipfile Rakefile build.gradle build.gradle.kts composer.json go.mod go.sum mix.exs package.json pom.xml pyproject.toml rebar.config requirements.txt setup.cfg setup.py tox.ini tsconfig.json
