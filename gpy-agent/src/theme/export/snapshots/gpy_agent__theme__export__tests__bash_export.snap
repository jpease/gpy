source: src/theme/export/tests.rs
expression: "golden_export(Shell::Bash)"
---
# GPY Theme: night$owl"
# Generated by gpy-agent for Bash

__gpy_theme_name="night\$owl\""
export GPY_AGENT_ENABLED="0"
export GPY_AGENT_LIVE_UPDATES="0"
export GPY_AGENT_SUPERVISOR_ENABLED="0"
export GPY_AGENT_SUPERVISOR_CHECK_INTERVAL_SECONDS="45"
export GPY_AGENT_SUPERVISOR_MAX_RESTART_ATTEMPTS="9"
export GPY_AGENT_TIMEOUT_SECONDS="7"
export GPY_LANGUAGE_ENABLED="0"
export GPY_LANGUAGE_SHOW_VERSIONS="0"
export GPY_GIT_ENABLED="1"
export GPY_GIT_SHOW_UPSTREAM="0"
export GPY_GIT_MAX_BRANCH_LENGTH="17"
export GPY_UI_DIRECTORY_MAX_LENGTH="42"
export GPY_UI_DIRECTORY_DISPLAY="truncated"
export GPY_UI_SHOW_ICONS="0"
export GPY_UI_TRANSIENT_PROMPT="1"
__prompt_icons="ascii"
__icon_powerline_segment_start=""
__icon_powerline_segment_end=""
__gpy_ui_prompt_icon="➜\$p"
__icon_prompt="➜\$p"
__gpy_ui_prompt_icon_color="magenta"
__prompt_color="magenta"
__gpy_ui_root_prompt_icon="#\`r\`"
__icon_root_prompt="#\`r\`"
__gpy_ui_root_prompt_icon_color="yellow"
__root_prompt_color="yellow"
__gpy_two_line="1"
__gpy_add_newline="1"
__color_clock_bg="blue"
__color_clock_fg="white"
__time_format="%H:%M\$(date)"
__clock_show_leading_zero="1"
__clock_show_seconds="1"
__clock_format="1"
__duration_threshold_ms="2500"
__color_directory_bg="cyan"
__color_duration_bg="yellow"
__color_hostname_bg="green"
__color_hostname_fg="black"
__hostname_trim_at=".local\""
__hostname_show_always="1"
__hostname_format="1"
__icon_hostname="host\\"
__color_username_bg="red"
__color_username_fg="white"
__color_username_user_bg="yellow"
__color_username_user_fg="black"
__username_show_always="1"
__username_format="1"
__icon_username="user\`x\`"
__icon_status_ok="ok\$1"
__icon_status_fail="fail\`2\`"
__color_status_ok_bg="green"
__color_status_ok_fg="black"
__color_status_fail_bg="red"
__color_status_fail_fg="white"
__status_format=""
__color_git_clean_bg="green"
__color_git_dirty_bg="red"
__color_language_bg="blue"
__segment_delim_first="["
__segment_delim_start=""
__segment_delim_end=""
__segment_delim_last="]"
__prompt_open_color="cyan"
__prompt_open_bg="blue"
__prompt_close_color="green"
__prompt_close_bg="red"
__segment_delimiter_color="white"
__segment_delimiter_bg="black"
__prompt_base_bg="normal"
__prompt_base_fg="normal"
__gpy_segment_aws_profile_id="aws-profile"
__gpy_segment_aws_profile_bg_color="yellow"
__color_aws_profile_bg="yellow"
__gpy_segment_aws_profile_text_color="black"
__color_aws_profile_fg="black"
__gpy_segment_aws_profile_icon="aws"
__icon_aws_profile="aws"
__gpy_segment_aws_profile_open_icon="<"
__gpy_segment_aws_profile_open_icon_color="white"
__gpy_segment_aws_profile_open_bg_color="black"
__gpy_segment_aws_profile_close_icon=">"
__gpy_segment_aws_profile_close_icon_color="black"
__gpy_segment_aws_profile_close_bg_color="white"
__gpy_segment_kubernetes_id="kubernetes"
__gpy_segment_kubernetes_bg_color="blue"
__color_kubernetes_bg="blue"
__gpy_segment_kubernetes_text_color="white"
__color_kubernetes_fg="white"
__gpy_segment_kubernetes_icon="k8s\$ctx"
__icon_kubernetes="k8s\$ctx"
__gpy_segment_kubernetes_context_color="brblue"
__color_kubernetes_context="brblue"
__gpy_segment_kubernetes_namespace_icon="ns\`n\`"
__icon_kubernetes_namespace="ns\`n\`"
__gpy_segment_kubernetes_plain_property="value\\"
__enabled_segments="clock username hostname directory git duration status"
__gpy_lang_marker_files=(.ruby-version CMakeLists.txt Cargo.toml Gemfile Makefile Package.swift Pipfile Rakefile build.gradle build.gradle.kts composer.json go.mod go.sum mix.exs package.json pom.xml pyproject.toml rebar.config requirements.txt setup.cfg setup.py tox.ini tsconfig.json)

__gpy_segment_bg() {
    local __gpy_sbg=""
    case "$1" in
        git) __gpy_sbg="${__color_git_clean_bg:-}" ;;
        language) __gpy_sbg="${__color_language_bg:-}" ;;
        directory) __gpy_sbg="${__color_directory_bg:-}" ;;
        duration) __gpy_sbg="${__color_duration_bg:-}" ;;
        clock) __gpy_sbg="${__color_clock_bg:-}" ;;
        hostname) __gpy_sbg="${__color_hostname_bg:-}" ;;
        username)
            if [[ "${__gpy_is_root:-0}" == "1" ]]; then
                __gpy_sbg="${__color_username_bg:-}"
            else
                __gpy_sbg="${__color_username_user_bg:-}"
            fi
            ;;
        status)
            if [[ "${__gpy_last_status:-0}" -eq 0 ]]; then
                __gpy_sbg="${__color_status_ok_bg:-green}"
            else
                __gpy_sbg="${__color_status_fail_bg:-red}"
            fi
            ;;
        *) __gpy_sbg="" ;;
    esac
    if [[ -n "$2" ]]; then
        printf -v "$2" '%s' "$__gpy_sbg"
    else
        printf '%s' "$__gpy_sbg"
    fi
}
