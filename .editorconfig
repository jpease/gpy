# EditorConfig - http://editorconfig.org
# Unified formatting standards for GPY development

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Configuration and metadata files
[*.{toml,yaml,yml,json,jsonl}]
indent_size = 2

# Documentation
[*.md]
indent_size = 2
max_line_length = 80

# Build files
[Makefile]
indent_style = tab

# Rust source files
[*.rs]
indent_size = 4

# Shell scripts (Bash, Zsh, Fish)
[*.{sh,bash,zsh,fish}]
indent_size = 4

# Python scripts
[*.py]
indent_size = 4

# Justfile
[justfile]
indent_size = 4
