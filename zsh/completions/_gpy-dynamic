#compdef gpy
#
# Dynamic-value completion glue for the `gpy` CLI: live theme, palette and
# segment names via `gpy __complete <kind>`; every other position delegates to
# the generated `_gpy`. Design notes: docs/dev/completions.md.
_gpy-dynamic() {
    # Defined inside this function: a second top-level function would make zsh's
    # autoload treat the file as the body and no-op on the first TAB. Call it as
    # a plain statement (never `$(...)`) and read `__gpy_complete_result`.
    __gpy_complete_cached() {
        local kind="$1"
        local cache_var="__gpy_complete_cache_$kind"
        local cache_val="${(P)cache_var}"

        if [[ -z "$cache_val" ]]; then
            cache_val="$(gpy __complete "$kind" 2>/dev/null)"
            if [[ -z "$cache_val" ]]; then
                __gpy_complete_result=""
                return 1
            fi
            typeset -g "$cache_var=$cache_val"
        fi

        __gpy_complete_result="$cache_val"
    }

    local sub1="${words[2]:-}"
    local sub2="${words[3]:-}"

    case "$sub1" in
        theme)
            case "$sub2" in
                use | validate)
                    if (( CURRENT == 4 )); then
                        __gpy_complete_cached theme
                        local -a vals
                        vals=("${(f)__gpy_complete_result}")
                        _describe -t gpy-themes 'theme' vals
                        return
                    fi
                    ;;
            esac
            ;;
        palette)
            case "$sub2" in
                use | validate)
                    if (( CURRENT == 4 )); then
                        __gpy_complete_cached palette
                        local -a vals
                        vals=("${(f)__gpy_complete_result}")
                        _describe -t gpy-palettes 'palette' vals
                        return
                    fi
                    ;;
            esac
            ;;
        enable | disable)
            if (( CURRENT == 3 )); then
                __gpy_complete_cached segment
                local -a vals
                vals=("${(f)__gpy_complete_result}")
                _describe -t gpy-segments 'segment' vals
                return
            fi
            ;;
    esac

    # Not a dynamic-value position: delegate to the generated structural
    # `_gpy` completion function so subcommand/flag completion still works.
    # Degrade gracefully (no candidates, no error) if it isn't
    # defined/loadable -- e.g. the structural completions failed to
    # generate/install, or the `gpy` CLI was never installed.
    if (( ${+functions[_gpy]} )); then
        _gpy
    fi
}
