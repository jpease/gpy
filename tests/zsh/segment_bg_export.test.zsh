#!/usr/bin/env zsh
# tests/zsh/segment_bg_export.test.zsh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# __gpy_segment_bg is generated by the agent's `theme export`
# (gpy-agent/src/theme/export/theme_to_shell.rs's append_segment_bg_function, built from
# SEGMENT_BG_VARS), not hand-copied as a `case "$seg" in ... esac` table
# in zsh/core/init.zsh. This test sources a REAL export from the
# locally-built debug binary (not whatever `gpy-agent` happens to be
# installed on PATH, which may be an older release) and checks:
#   1. Without a recorded git_bg file, __gpy_segment_bg git returns
#      $__color_git_clean_bg.
#   2. With one, it returns the recorded colour without forking; agent-free
#      renders and shells lacking __gpy_git_segment_bg keep the clean colour.

ROOT=${0:a:h:h:h}
# Shared skip contract: exits 0 locally, fails under CI.
emulate sh -c '. "$ROOT/tests/lib/shell_e2e.sh"'
cd "$ROOT"

AGENT_BIN="$ROOT/gpy-agent/target/debug/gpy-agent"
if [[ ! -x "$AGENT_BIN" ]]; then
    test_skip "$AGENT_BIN not built (run \`cargo build\` in gpy-agent first)"
fi

source zsh/core/constants.zsh
source zsh/core/ipc.zsh

SANDBOX=$(mktemp -d "${TMPDIR:-/tmp}/gpy-segbg.XXXXXX")
trap 'rm -rf "$SANDBOX"' EXIT
export XDG_CACHE_HOME="$SANDBOX/cache"

export_output=$("$AGENT_BIN" theme export --shell zsh 2>/dev/null)
if [[ -z "$export_output" ]]; then
    echo "FAIL: gpy-agent theme export --shell zsh produced no output"
    exit 1
fi
eval "$export_output"

check "__gpy_segment_bg git matches \$__color_git_clean_bg" \
    "${__color_git_clean_bg:-}" "$(__gpy_segment_bg git)"

# Fork-free out-var calling convention (the render loop's hot path).
out_var_result=""
__gpy_segment_bg git out_var_result
check "__gpy_segment_bg git OUT_VAR writes the same value" \
    "${__color_git_clean_bg:-}" "$out_var_result"

check "unknown segment returns empty" "" "$(__gpy_segment_bg not-a-real-segment)"

# A recorded colour reaches the render loop through the generated function.
repo="$SANDBOX/repo"
mkdir -p "$repo/.git"
cache_dir="$XDG_CACHE_HOME/gpy/instant-prompts" key="" bg_tail=""
__gpy_path_to_cache_key "$(realpath "$repo")" key
__gpy_git_bg_file_tail zsh bg_tail
mkdir -p "$cache_dir"
bg_file="$cache_dir/$key.$bg_tail"
cd "$repo" || exit 1

check "no git_bg file: the clean colour" \
    "${__color_git_clean_bg:-}" "$(__gpy_segment_bg git)"

printf 'red' >"$bg_file"
check "git_bg file: the recorded colour" red "$(__gpy_segment_bg git)"
out_var_result=""
__gpy_segment_bg git out_var_result
check "git_bg file: OUT_VAR form" red "$out_var_result"

__gpy_git_seg_status="$__gpy_seg_status_oneshot"
check "agent-free git render ignores the file" \
    "${__color_git_clean_bg:-}" "$(__gpy_segment_bg git)"
unset __gpy_git_seg_status

forks="$SANDBOX/forks"
: >"$forks"
out_var_result=""
trap '(( ZSH_SUBSHELL > 0 )) && print -r -- "${funcstack[1]}: $ZSH_DEBUG_CMD" >>"$forks"' DEBUG
__gpy_segment_bg git out_var_result
trap - DEBUG
check "fork check reads the recorded colour" red "$out_var_result"
check "zsh $ZSH_VERSION: reading the colour runs no subshell" "" "$(<"$forks")"

unfunction __gpy_git_segment_bg
err_output=$(__gpy_segment_bg git 2>&1)
check "without the helper: the clean colour, no error" \
    "${__color_git_clean_bg:-}" "$err_output"

cd "$ROOT" || exit 1

test_finish "segment_bg export test"
