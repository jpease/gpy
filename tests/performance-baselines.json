{
  "version": "1.0.0",
  "description": "Performance baselines and budgets for GPY agent",
  "budgets": {
    "ipc_latency": {
      "target_ms": 1.0,
      "max_ms": 1.5,
      "description": "IPC roundtrip latency budget"
    },
    "git_status_cold": {
      "target_ms": 500.0,
      "max_ms": 750.0,
      "description": "Git status scan (cold cache) budget"
    },
    "cache_write": {
      "target_ms": 10.0,
      "max_ms": 25.0,
      "description": "Cache write operation budget"
    },
    "cache_read": {
      "target_ms": 1.0,
      "max_ms": 5.0,
      "description": "Cache read operation budget"
    },
    "language_detection": {
      "target_ms": 100.0,
      "max_ms": 200.0,
      "description": "Language detection budget"
    },
    "prompt_render": {
      "target_ms": 20.0,
      "max_ms": 50.0,
      "description": "Warm prompt render budget (agent up, instant cache fresh)"
    },
    "prompt_render_cold": {
      "target_ms": 150.0,
      "max_ms": 300.0,
      "description": "Cold-cache prompt render budget (instant cache cleared each render)"
    },
    "prompt_render_stale": {
      "target_ms": 40.0,
      "max_ms": 100.0,
      "description": "Stale-cache prompt render budget (serve-stale path)"
    },
    "prompt_render_degraded": {
      "target_ms": 80.0,
      "max_ms": 200.0,
      "description": "Agent-unavailable prompt render budget (graceful fallback)"
    },
    "prompt_render_bash": {
      "target_ms": 37.0,
      "max_ms": 111.0,
      "description": "Bash per-render cost (__gpy_precmd + PS1 expansion, agent up)"
    },
    "prompt_render_zsh": {
      "target_ms": 13.0,
      "max_ms": 39.0,
      "description": "Zsh per-render cost (precmd_functions + PROMPT expansion, agent up)"
    },
    "memory_usage": {
      "target_mb": 15.0,
      "max_mb": 50.0,
      "description": "Agent memory usage budget (RSS)"
    },
    "memory_long_running": {
      "target_mb": 20.0,
      "max_mb": 50.0,
      "description": "Agent peak RSS budget under sustained long-running prompt load"
    },
    "config_validation": {
      "target_ms": 50.0,
      "max_ms": 100.0,
      "description": "Configuration validation budget"
    },
    "theme_manager_load": {
      "target_ms": 5.0,
      "max_ms": 20.0,
      "description": "ThemeManager::new load budget (Agent::new cold-start sub-step)"
    },
    "theme_export_write": {
      "target_ms": 10.0,
      "max_ms": 30.0,
      "description": "write_theme_export_cache atomic write budget (Agent::new cold-start sub-step)"
    },
    "version_command_spawn": {
      "target_ms": 10.0,
      "max_ms": 50.0,
      "description": "Version-detection subprocess spawn/read/timeout/parse overhead budget, stub command"
    }
  },
  "regression_thresholds": {
    "measurement_variance_percent": 15.0
  }
}
